{
  "name": "corp-messenger",
  "version": "0.1.0",
  "private": true,
  "description": "Web-приложение корпоративного мессенджера с поддержкой тематических каналов и ролевого разграничения доступа",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igordel004/corp-messenger.git"
  },
  "keywords": [
    "messenger",
    "rbac",
    "react",
    "express",
    "websocket"
  ],
  "author": "Токарев И. Е.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Igordel004/corp-messenger/issues"
  },
  "homepage": "https://github.com/Igordel004/corp-messenger#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
